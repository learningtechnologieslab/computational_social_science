}
# --- Run it ------------------------------------------------------------------
# Three empty rows of numbers, one slot per year, which the loop fills in.
adoption <- numeric(length(years3))
quantity <- numeric(length(years3))
price    <- numeric(length(years3))
for (i in seq_along(years3)) {
year <- years3[i]
A <- adopted_fraction(year)                    # how far adoption has spread
Q <- SUPPLY_FIXED * (1 + EXPANSION * A)        # total world supply this year
a <- demand_intercept_ramp(year)               # how keen buyers are this year
p <- (a - Q) / DEMAND_SLOPE                    # the price that clears the market
adoption[i] <- A
quantity[i] <- Q
price[i]    <- p
}
# --- Draw three stacked panels: cause, mechanism, consequence ----------------
par(mfrow = c(3, 1), mar = c(4, 5.5, 3, 1.5))
# sapply() applies a function to every element of a vector and collects the
# answers - the tidy way to evaluate demand_intercept_ramp() for every year.
demand_by_year <- sapply(years3, demand_intercept_ramp)
plot(years3, demand_by_year, type = "n", xlab = "", ylab = "demand strength",
main = "Cause: Western shoppers discover quinoa (2006-2013)")
add_grid()
lines(years3, demand_by_year, lwd = 2, col = TAB["blue"])
plot(years3, 100 * adoption, type = "n", xlab = "",
ylab = "new growers who\nhave adopted (%)",
main = "Mechanism: adoption spreads along an S-curve, arriving late")
add_grid()
lines(years3, 100 * adoption, lwd = 2, col = TAB["green"])
plot(years3, price, type = "n", xlab = "year", ylab = "price (soles/kg)",
main = "Consequence: boom, then bust - which nobody put in by hand")
add_grid()
lines(years3, price, lwd = 2, col = TAB["red"])
abline(v = 2013, col = TAB["grey"], lty = 2)
text(2013.4, max(price) * 0.55, "price peaks, then\nnew supply arrives",
cex = 0.8, col = TAB["grey"], adj = 0)
par(mfrow = c(1, 1))
peak_year <- years3[which.max(price)]
cat(sprintf("Price peaks in %d at %.1f, having started at %.1f.\n",
peak_year, max(price), price[1]))
cat(sprintf("By %d it has fallen to %.1f - still above the old level, but well off the peak.\n",
years3[length(years3)], price[length(price)]))
# ---------------------------------------------------------------------------
# MODEL 4: coupled soil / herd / land-use dynamics
# ---------------------------------------------------------------------------
years4 <- 2000:2040   # run well past the boom, to see the aftermath
# --- The price story, taken from the article: rise to 2013, fall by 2016 -----
relative_price <- function(year) {
# Expressed as a multiple of the pre-boom price, so 1.0 = "normal", 4.0 = "quadrupled".
if (year < 2006)  return(1.0)
if (year <= 2013) return(1.0 + 3.0 * (year - 2006) / 7.0)   # climb from 1x to 4x
if (year <= 2016) return(4.0 - 2.0 * (year - 2013) / 3.0)   # fall from 4x to 2x
2.0                                                          # settle at twice pre-boom
}
# --- Parameters --------------------------------------------------------------
REGEN     <- 0.10      # "g":   how fast resting (fallow) land rebuilds fertility
MANURE    <- 0.0225    # "m":   fertility added per unit of llama herd
DEPLETION <- 0.09      # "k":   fertility removed per unit of land cropped
HERD_GROW <- 0.35      # "rho": how fast the herd grows toward what pasture allows
S_MAX     <- 1.0       # the best the soil gets: its pristine pre-boom condition
BASE_AREA <- 0.25      # fraction of land in quinoa at the normal price
RESPONSE  <- 0.5       # how strongly planting responds to price (0.5 = square-root)
# These parameters are deliberately tuned so that at the pre-boom price the
# system sits STILL: inflows exactly balance outflows, soil stays at 1.0, herd
# stays at 1.0. That matters. It means anything we see later was caused by the
# boom and not by a slow drift we accidentally built in. Always establish that
# your model does nothing before you ask it to do something.
planted_fraction <- function(price) {
# Farmers plant more when the price is high, with diminishing enthusiasm,
# and can never plant more than 85% of their land.
min(0.85, BASE_AREA * price ^ RESPONSE)
}
run_soil_model <- function(soil_can_degrade = TRUE) {
# If soil_can_degrade is FALSE we hold fertility fixed at 1.0. That gives us
# a COUNTERFACTUAL: the same boom in a world where soil were indestructible.
# Comparing the two isolates the cost of degradation.
soil <- 1.0
herd <- 1.0
# Prepare an empty table with one row per year, then fill it in as we go.
history <- data.frame(year = years4, price = NA_real_, area = NA_real_,
soil = NA_real_, herd = NA_real_, harvest = NA_real_)
for (i in seq_along(years4)) {
year    <- years4[i]
price   <- relative_price(year)
q       <- planted_fraction(price)   # land in quinoa
pasture <- 1.0 - q                   # land left for llamas
yield_per_unit <- soil               # fertile soil grows more per hectare
harvest <- q * yield_per_unit        # this year's output
history[i, ] <- c(year, price, q, soil, herd, harvest)
# --- Update the two stocks: balance = balance + in - out -----------------
if (soil_can_degrade) {
recovery   <- REGEN * pasture * (S_MAX - soil)   # resting land rebuilds
fertiliser <- MANURE * herd                      # manure from llamas
loss       <- DEPLETION * q                      # cropping takes nutrients
soil <- min(S_MAX, max(0.05, soil + recovery + fertiliser - loss))
}
capacity <- max(pasture / (1.0 - BASE_AREA), 1e-6)  # pasture sets the ceiling
herd <- max(0.02, herd + HERD_GROW * herd * (1.0 - herd / capacity))
}
history
}
with_degradation    <- run_soil_model(soil_can_degrade = TRUE)
without_degradation <- run_soil_model(soil_can_degrade = FALSE)
# --- Draw four panels: cause, land use, the stock, and the bill --------------
par(mfrow = c(2, 2), mar = c(4.2, 5, 3.2, 1.5))
plot(years4, with_degradation$price, type = "n", xlab = "",
ylab = "price (multiple of pre-boom)", main = "The price shock we impose")
add_grid()
lines(years4, with_degradation$price, lwd = 2, col = TAB["orange"])
plot(years4, 100 * with_degradation$area, type = "n", xlab = "",
ylab = "% of land / relative herd size", ylim = c(20, 80),
main = "Land use responds; the herd is squeezed out")
add_grid()
lines(years4, 100 * with_degradation$area, lwd = 2, col = TAB["brown"])
lines(years4, 100 * with_degradation$herd * (1 - BASE_AREA), lwd = 2, col = TAB["purple"])
legend("topright", legend = c("land in quinoa", "llama herd (scaled)"),
col = c(TAB["brown"], TAB["purple"]), lwd = 2, bty = "n", cex = 0.8)
plot(years4, with_degradation$soil, type = "n", xlab = "year",
ylab = "fertility index",
ylim = range(c(with_degradation$soil, 1.0)) + c(-0.005, 0.012),
main = "The stock: soil fertility does not come back")
add_grid()
lines(years4, with_degradation$soil, lwd = 2, col = TAB["green"])
abline(h = 1.0, col = TAB["grey"], lty = 3)
plot(years4, with_degradation$harvest, type = "n", xlab = "year",
ylab = "harvest (index)",
ylim = range(c(with_degradation$harvest, without_degradation$harvest)),
main = "The bill arrives late, as lost output")
add_grid()
lines(years4, with_degradation$harvest, lwd = 2, col = TAB["blue"])
lines(years4, without_degradation$harvest, lwd = 2, lty = 2, col = TAB["orange"])
legend("bottomright", legend = c("with degradation", "counterfactual: soil indestructible"),
col = c(TAB["blue"], TAB["orange"]), lwd = 2, lty = c(1, 2), bty = "n", cex = 0.8)
par(mfrow = c(1, 1))
s <- with_degradation$soil
h_with    <- with_degradation$harvest
h_without <- without_degradation$harvest
n <- length(years4)
cat(sprintf("Soil fertility: 1.000 in 2000  ->  %.3f at the 2013 peak  ->  %.3f by 2040\n",
s[14], s[n]))
cat(sprintf("Harvest in 2040: %.3f with degradation vs %.3f without - a shortfall of %.1f%%.\n",
h_with[n], h_without[n], 100 * (1 - h_with[n] / h_without[n])))
# ---------------------------------------------------------------------------
# MODEL 5A: the two-farmer diversity game
# ---------------------------------------------------------------------------
# --- Parameters -------------------------------------------------------------
REVENUE_EXPORT      <- 100.0   # what you earn growing the variety exporters want
REVENUE_TRADITIONAL <- 70.0    # what you earn growing an old local variety
DIVERSITY_VALUE     <- 20.0    # value created for EVERYONE by each conserving farmer
# Note the tension deliberately built into these three numbers: conserving costs
# you 30 privately but creates 20 of value for EACH of the two farmers, i.e. 40
# in total. So conserving is good for the pair (40 > 30) and bad for you (20 < 30).
payoff <- function(my_choice, other_choice) {
# My private revenue depends only on my own choice.
private <- if (my_choice == "Traditional") REVENUE_TRADITIONAL else REVENUE_EXPORT
# The public benefit depends on how many of us conserve - mine and theirs alike.
# In R, TRUE counts as 1 and FALSE as 0 when you do arithmetic with them.
conservers <- (my_choice == "Traditional") + (other_choice == "Traditional")
private + DIVERSITY_VALUE * conservers
}
choices <- c("Export", "Traditional")
cat("Payoffs (Farmer A, Farmer B). Rows = A's choice, columns = B's choice.\n\n")
cat(sprintf("%-14s %22s %22s\n", "", "B: Export", "B: Traditional"))
for (a in choices) {
row_text <- ""
for (b in choices) {
pair <- sprintf("(%.0f, %.0f)", payoff(a, b), payoff(b, a))
row_text <- paste0(row_text, sprintf("%22s ", pair))
}
cat(sprintf("%-14s %s\n", paste0("A: ", a), row_text))
}
# --- Find the Nash equilibrium ----------------------------------------------
# Definition: a pair of choices where NEITHER farmer can do better by switching,
# taking the other's choice as fixed. Let us just check all four possibilities.
cat("\nChecking each outcome for stability:\n")
for (a in choices) {
for (b in choices) {
other_a <- choices[choices != a]      # A's alternative
other_b <- choices[choices != b]      # B's alternative
a_content <- payoff(a, b) >= payoff(other_a, b)   # would A rather switch?
b_content <- payoff(b, a) >= payoff(other_b, a)   # would B rather switch?
verdict <- if (a_content && b_content) {
"NASH EQUILIBRIUM - nobody wants to move"
} else {
"unstable"
}
cat(sprintf("  A=%-12s B=%-12s -> total welfare %5.0f   %s\n",
a, b, payoff(a, b) + payoff(b, a), verdict))
}
}
both_export   <- payoff("Export", "Export") + payoff("Export", "Export")
both_conserve <- payoff("Traditional", "Traditional") + payoff("Traditional", "Traditional")
cat(sprintf("\nEveryone growing export varieties yields total welfare of %.0f.\n", both_export))
cat(sprintf("Everyone conserving would yield %.0f - which is %.0f higher, and unreachable.\n",
both_conserve, both_conserve - both_export))
# ---------------------------------------------------------------------------
# MODEL 5B: how much would conservation cost?
# ---------------------------------------------------------------------------
N_FARMERS <- 150     # matching the interview sample size mentioned in the article
# Each farmer's willingness to accept, in soles per year. We use a lognormal
# distribution: most farmers cheap, a few very expensive, none negative. That
# right-skewed shape is typical of real willingness-to-accept data, and choosing
# it is itself a modeling assumption you should be prepared to defend.
wta <- rlnorm(N_FARMERS, meanlog = log(300), sdlog = 0.8)
payments <- seq(0, 2000, length.out = 400)   # 400 candidate payment levels to test
uptake        <- numeric(length(payments))
cost_uniform  <- numeric(length(payments))
cost_targeted <- numeric(length(payments))
for (i in seq_along(payments)) {
offer      <- payments[i]
conserving <- wta <= offer            # TRUE/FALSE for each farmer
n_conserving <- sum(conserving)        # TRUE counts as 1
uptake[i]  <- 100 * n_conserving / N_FARMERS
# Way 1 - UNIFORM: advertise one price and pay it to everyone who accepts.
# Simple, transparent, and you overpay every farmer who would have said yes
# for less. That overpayment is called "rent".
cost_uniform[i] <- offer * n_conserving
# Way 2 - TARGETED: pay each farmer exactly their own willingness to accept.
# Cheaper, but it requires knowing a private number, which is precisely what
# auctions and pilot schemes are trying to discover.
cost_targeted[i] <- sum(wta[conserving])
}
par(mfrow = c(1, 2), mar = c(4.5, 5, 3.5, 1.5))
hist(wta, breaks = 30, col = TAB["blue"], border = "white",
xlab = "willingness to accept (soles per year)", ylab = "number of farmers",
main = "Farmers are not identical")
abline(v = median(wta), col = TAB["red"], lty = 2, lwd = 2)
text(median(wta) * 1.15, par("usr")[4] * 0.8,
sprintf("median\n%.0f soles", median(wta)), col = TAB["red"], cex = 0.8, adj = 0)
plot(uptake, cost_uniform, type = "n",
xlab = "% of farmers conserving a traditional variety",
ylab = "total annual cost (soles)",
main = "What conservation costs, and how you pay for it")
add_grid()
lines(uptake, cost_uniform,  lwd = 2, col = TAB["blue"])
lines(uptake, cost_targeted, lwd = 2, lty = 2, col = TAB["orange"])
legend("topleft", legend = c("uniform payment to all takers", "payment tailored to each farmer"),
col = c(TAB["blue"], TAB["orange"]), lwd = 2, lty = c(1, 2), bty = "n", cex = 0.8)
par(mfrow = c(1, 1))
# What does it cost to reach a 60% conservation target?
target <- 60.0
i <- which(uptake >= target)[1]    # the first payment level that reaches the target
cat(sprintf("To get %.0f%% of farmers conserving:\n", target))
cat(sprintf("  offer                   : %6.0f soles per farmer per year\n", payments[i]))
cat(sprintf("  cost, uniform payment   : %6.0f soles per year\n", cost_uniform[i]))
cat(sprintf("  cost, tailored payment  : %6.0f soles per year\n", cost_targeted[i]))
cat(sprintf("  overpayment ('rent')    : %6.0f soles, or %.0f%% of the uniform bill\n",
cost_uniform[i] - cost_targeted[i],
100 * (cost_uniform[i] - cost_targeted[i]) / cost_uniform[i]))
# ---------------------------------------------------------------------------
# MODEL 6: fitting a subsistence floor to Stevens's two findings
# ---------------------------------------------------------------------------
# --- The observations from the article --------------------------------------
NATIONAL <- list(name = "Peru as a whole", q_2004 = 6.07,  q_2012 = 4.09,  budget_share = 0.005)
PUNO     <- list(name = "Puno region",     q_2004 = 22.22, q_2012 = 23.62, budget_share = 0.040)
PRICE_2004 <- 2.0     # soles per kilogram (an arbitrary but harmless scale)
PRICE_2012 <- 8.0     # the roughly fourfold increase the article reports
INCOME_GROWTH <- 1.40 # Peruvian living standards rose over this period; the article
# notes all three household groups saw their welfare rise.
stone_geary_prediction <- function(floor, q_start, price_start, price_end,
budget_start, budget_end) {
# Step 1: work out the household's marginal budget share "alpha" from the
# fact that it consumed q_start when the price was price_start. This is
# called CALIBRATION: we do not guess alpha, we solve for the value that
# makes the model exactly reproduce the starting point.
spare_budget <- budget_start - price_start * floor      # money left after the floor
if (spare_budget <= 0 || q_start <= floor) {
return(NA_real_)                                      # this floor is impossible
}
alpha <- (q_start - floor) * price_start / spare_budget
# Step 2: with alpha fixed, predict consumption at the new price and income.
spare_later <- budget_end - price_end * floor
if (spare_later <= 0) {
return(NA_real_)
}
floor + (alpha / price_end) * spare_later
}
analyse <- function(region) {
# Recover the household budget from the budget share quoted in the article.
budget_2004 <- region$q_2004 * PRICE_2004 / region$budget_share
budget_2012 <- budget_2004 * INCOME_GROWTH
# First: the standard model, i.e. a floor of exactly zero.
plain <- stone_geary_prediction(0.0, region$q_2004, PRICE_2004, PRICE_2012,
budget_2004, budget_2012)
# Then: try every floor from 0 up to just below what they already eat, and
# see which one comes closest to the observed 2012 figure. This is a "grid
# search" - the least clever and most transparent way to fit a parameter.
floors <- seq(0, region$q_2004 * 0.999, length.out = 2000)
predictions <- sapply(floors, function(f) {
stone_geary_prediction(f, region$q_2004, PRICE_2004, PRICE_2012,
budget_2004, budget_2012)
})
errors <- abs(predictions - region$q_2012)
best <- which.min(errors)      # which.min quietly ignores the impossible (NA) floors
list(region = region, budget_2004 = budget_2004, plain = plain,
floors = floors, predictions = predictions, errors = errors,
best_floor = floors[best], best_prediction = predictions[best],
best_error = errors[best])
}
national <- analyse(NATIONAL)
puno     <- analyse(PUNO)
for (res in list(national, puno)) {
r <- res$region
cat(strrep("=", 66), "\n", sep = "")
cat(r$name, "\n")
cat(sprintf("  observed 2004 -> 2012            : %.2f -> %.2f kg per person\n",
r$q_2004, r$q_2012))
cat(sprintf("  standard model (no floor) predicts: %.2f kg\n", res$plain))
cat(sprintf("  best-fitting floor               : %.2f kg, predicting %.2f kg\n",
res$best_floor, res$best_prediction))
cat(sprintf("  remaining error                  : %.2f kg\n", res$best_error))
}
cat(strrep("=", 66), "\n", sep = "")
# ---------------------------------------------------------------------------
# Draw the fit for each region: how close can the model get, for any floor?
# ---------------------------------------------------------------------------
par(mfrow = c(1, 2), mar = c(4.8, 5, 3.5, 1.5), oma = c(0, 0, 2.5, 0))
for (res in list(national, puno)) {
r <- res$region
# IMPORTANT: unlike matplotlib's axhline, R's abline() does not stretch the
# axes to fit. The Puno observation sits ABOVE every prediction, so we must
# include the reference values in ylim or the red line would be invisible -
# and it is the whole point of the panel.
y_all <- c(res$predictions, r$q_2012, r$q_2004)
y_range <- range(y_all, na.rm = TRUE) + c(-0.35, 0.75)
plot(res$floors, res$predictions, type = "n", ylim = y_range,
xlab = "assumed subsistence floor, gamma (kg per person per year)",
ylab = "predicted 2012 consumption (kg)", main = r$name)
add_grid()
lines(res$floors, res$predictions, lwd = 2, col = TAB["blue"])
abline(h = r$q_2012, col = TAB["red"],  lty = 2, lwd = 1.5)
abline(h = r$q_2004, col = TAB["grey"], lty = 3)
# Mark the best fit only if the model can actually get close.
if (res$best_error < 0.15) {
points(res$best_floor, res$best_prediction, pch = 19, cex = 1.1)
# text() writes the label, arrows() draws the pointer from label to point.
label_x <- max(res$floors) * 0.05
label_y <- res$best_prediction * 1.38
text(label_x, label_y, sprintf("floor = %.1f kg\nfits exactly", res$best_floor),
cex = 0.8, adj = 0)
arrows(label_x + max(res$floors) * 0.22, label_y * 0.97,
res$best_floor * 0.96, res$best_prediction * 1.04,
length = 0.08, lwd = 1)
} else {
# Point the arrow at the GAP: where the prediction line stops short.
gap_y <- 0.5 * (res$best_prediction + r$q_2012)
arrows(max(res$floors) * 0.45, r$q_2012 * 0.62,
max(res$floors) * 0.97, gap_y, length = 0.08, lwd = 1)
text(max(res$floors) * 0.03, r$q_2012 * 0.55,
"the prediction line never\nreaches the observation:\nNO floor can explain this",
cex = 0.8, col = TAB["red"], adj = 0)
}
legend("bottomright",
legend = c("model prediction for 2012",
sprintf("observed 2012: %.2f kg", r$q_2012),
sprintf("observed 2004: %.2f kg", r$q_2004)),
col = c(TAB["blue"], TAB["red"], TAB["grey"]),
lwd = c(2, 1.5, 1), lty = c(1, 2, 3), bty = "n", cex = 0.72)
}
mtext("Model 6: one model, one success and one honest failure",
outer = TRUE, cex = 1.0)
par(mfrow = c(1, 1), oma = c(0, 0, 0, 0))
# ---------------------------------------------------------------------------
# MODEL 7: the spread of a claim, and the arrival of evidence
# ---------------------------------------------------------------------------
MONTHS <- 72                # six years, roughly 2010 to 2016
STEP   <- 0.25              # we advance in quarter-month steps for smoothness
TRANSMISSION    <- 0.42     # "beta":  how readily the claim passes on
FORGETTING      <- 0.05     # "delta": how fast people drop it unprompted
EVIDENCE_EFFECT <- 8.0      # how much faster people drop it once evidence lands
SEED_SHARE      <- 0.002    # the tiny fraction who believe it at the very start
run_epidemic <- function(evidence_month) {
# Three compartments, as fractions of the population, adding to 1.
S <- 1.0 - SEED_SHARE
B <- SEED_SHARE
R <- 0.0
# How many steps we will take, and empty rows of numbers to record each one.
n_steps <- floor(MONTHS / STEP)
out <- data.frame(t = numeric(n_steps), S = numeric(n_steps),
B = numeric(n_steps), R = numeric(n_steps))
t <- 0.0
for (i in seq_len(n_steps)) {
# Has the debunking evidence been published yet? If so, people abandon
# the claim much faster. Note we model evidence as changing a RATE, not
# as instantly convincing everyone - which is the realistic version.
drop_rate <- FORGETTING
if (t >= evidence_month) {
drop_rate <- FORGETTING * EVIDENCE_EFFECT
}
# The flows during this small slice of time.
newly_convinced <- TRANSMISSION * S * B * STEP
newly_dropped   <- drop_rate * B * STEP
# Move people between compartments. Whatever leaves S enters B, and
# whatever leaves B enters R. Nobody is created or destroyed - a useful
# thing to check in any model of this kind.
S <- S - newly_convinced
B <- B + newly_convinced - newly_dropped
R <- R + newly_dropped
out[i, ] <- c(t, S, B, R)
t <- t + STEP
}
out
}
# Two worlds: evidence at 12 months, and evidence at 42 months.
early <- run_epidemic(evidence_month = 12)
late  <- run_epidemic(evidence_month = 42)
# A helper of our own for drawing stacked bands. Base R has no stackplot, so we
# draw each band as a filled polygon: along the bottom edge left-to-right, then
# back along the top edge right-to-left. rev() reverses a row of numbers.
stacked_band <- function(t, lower, upper, colour) {
polygon(c(t, rev(t)), c(lower, rev(upper)), col = colour, border = NA)
}
par(mfrow = c(1, 2), mar = c(4.5, 5, 3.5, 1.5), oma = c(0, 0, 2.5, 0))
runs   <- list(early, late)
whens  <- c(12, 42)
titles <- c("Evidence published early (month 12)", "Evidence published late (month 42)")
for (k in 1:2) {
run <- runs[[k]]
t <- run$t
# The three cumulative boundaries between the bands, in percentage points.
b1 <- 100 * run$S                      # top of the "never heard it" band
b2 <- 100 * (run$S + run$B)            # top of the "believes it" band
y_label <- if (k == 1) "% of population" else ""
plot(range(t), c(0, 100), type = "n", xlab = "months", ylab = y_label,
main = titles[k], cex.main = 0.95)
stacked_band(t, rep(0, length(t)), b1, TAB["pale"])    # never heard it
stacked_band(t, b1, b2, TAB["red"])                    # believes and repeats it
stacked_band(t, b2, rep(100, length(t)), TAB["steel"]) # no longer repeats it
abline(v = whens[k], lty = 2, lwd = 1.5)
text(whens[k] + 1, 88, "evidence\narrives", cex = 0.8, adj = 0)
if (k == 1) {
legend("left", legend = c("never heard it", "believes and repeats it",
"no longer repeats it"),
fill = c(TAB["pale"], TAB["red"], TAB["steel"]),
border = NA, bty = "n", cex = 0.8)
}
}
mtext("Model 7: the same claim, corrected early and corrected late",
outer = TRUE, cex = 1.0)
par(mfrow = c(1, 1), oma = c(0, 0, 0, 0))
# How many people ever believed it? That is everyone who left S: 1 minus the
# fraction still in S at the end.
for (k in 1:2) {
run  <- runs[[k]]
name <- c("early correction", "late correction")[k]
ever <- 100 * (1 - run$S[nrow(run)])
peak <- 100 * max(run$B)
peak_month <- run$t[which.max(run$B)]
cat(sprintf("%-18s: %5.1f%% ever believed it | peak %4.1f%% believing at once, in month %.0f\n",
name, ever, peak, peak_month))
}
# ---------------------------------------------------------------------------
# CODA: why you compare changes, not levels
# ---------------------------------------------------------------------------
N <- 4000                     # households in our synthetic survey
TRUE_EFFECT <- 500.0          # the real gain to growers from the boom, in soles.
# We KNOW this because we are about to create it.
# Half the households grow quinoa. Growers are poorer to start with - this is the
# fact from the article that makes naive comparison misleading.
is_grower <- runif(N) < 0.5
baseline_welfare <- ifelse(is_grower, 4800.0, 9600.0)
# Everyone's welfare rises over the period, because Peru grew. The article is
# explicit that all three groups saw living standards improve.
COMMON_TREND <- 900.0
# Survey noise: every household is idiosyncratic, and surveys are imperfect.
noise_before <- rnorm(N, mean = 0, sd = 1200)
noise_after  <- rnorm(N, mean = 0, sd = 1200)
welfare_before <- baseline_welfare + noise_before
welfare_after  <- baseline_welfare + COMMON_TREND + TRUE_EFFECT * is_grower + noise_after
# --- The wrong comparison: growers vs non-growers, after the boom only -------
# The "!" means "not", so !is_grower picks out the non-growers.
naive <- mean(welfare_after[is_grower]) - mean(welfare_after[!is_grower])
# --- The right comparison: how much each group CHANGED -----------------------
change_growers     <- mean(welfare_after[is_grower])  - mean(welfare_before[is_grower])
change_non_growers <- mean(welfare_after[!is_grower]) - mean(welfare_before[!is_grower])
did <- change_growers - change_non_growers     # difference in the differences
cat(sprintf("True effect of the boom on growers      : %+8.0f soles\n", TRUE_EFFECT))
cat(strrep("-", 58), "\n", sep = "")
cat(sprintf("Naive comparison of levels after the boom: %+8.0f soles  <-- badly wrong, wrong sign\n", naive))
cat(sprintf("Change among growers                     : %+8.0f soles\n", change_growers))
cat(sprintf("Change among non-growers                 : %+8.0f soles\n", change_non_growers))
cat(sprintf("Difference-in-differences estimate       : %+8.0f soles  <-- close to the truth\n", did))
# --- Picture it --------------------------------------------------------------
par(mfrow = c(1, 1), mar = c(4.5, 5, 3.5, 6))
grower_line     <- c(mean(welfare_before[is_grower]),  mean(welfare_after[is_grower]))
non_grower_line <- c(mean(welfare_before[!is_grower]), mean(welfare_after[!is_grower]))
# The dashed line shows where growers WOULD have ended up with only the common
# trend and no boom effect. The gap between it and reality is the estimate.
counterfactual <- mean(welfare_before[is_grower]) + change_non_growers
plot(c(0, 1), range(c(grower_line, non_grower_line)) + c(-500, 500), type = "n",
xlim = c(-0.15, 1.35), xaxt = "n", xlab = "",
ylab = "average welfare (soles)",
main = "Coda: growers stay poorer in levels, yet gain more")
axis(1, at = c(0, 1), labels = c("before the boom", "after the boom"))
add_grid()
lines(c(0, 1), grower_line,     lwd = 2.5, col = TAB["blue"])
points(c(0, 1), grower_line,    pch = 19, col = TAB["blue"])
lines(c(0, 1), non_grower_line, lwd = 2.5, col = TAB["orange"])
points(c(0, 1), non_grower_line, pch = 19, col = TAB["orange"])
lines(c(0, 1), c(mean(welfare_before[is_grower]), counterfactual),
lty = 2, lwd = 1.5, col = TAB["grey"])
# A double-headed arrow (code = 3) marking the gap that the method estimates.
arrows(1, counterfactual, 1, grower_line[2], code = 3, length = 0.07,
lwd = 1.8, col = TAB["red"])
text(1.03, (grower_line[2] + counterfactual) / 2, "this gap is\nthe estimate",
col = TAB["red"], cex = 0.8, adj = 0)
legend("left", legend = c("quinoa growers (poorer, gain more)",
"non-growers (richer, gain less)",
"growers' counterfactual path"),
col = c(TAB["blue"], TAB["orange"], TAB["grey"]),
lwd = c(2.5, 2.5, 1.5), lty = c(1, 1, 2), bty = "n", cex = 0.75)
